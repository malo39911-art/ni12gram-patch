diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/Ni12LocalEmoji.java b/TMessagesProj/src/main/java/org/telegram/messenger/Ni12LocalEmoji.java
new file mode 100644
index 00000000..e05c99ae
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/Ni12LocalEmoji.java
@@ -0,0 +1,95 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Premium (custom) emoji for non-premium accounts, visible only on this device.
+ * Telegram's server drops custom-emoji entities for non-premium senders, so we remember them locally
+ * and re-attach them to our own outgoing messages. Other people see the normal fallback emoji.
+ */
+public final class Ni12LocalEmoji {
+
+    private static final ConcurrentHashMap<String, String> pending = new ConcurrentHashMap<>();
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("ni12emoji", Context.MODE_PRIVATE);
+    }
+
+    public static String serialize(ArrayList<TLRPC.MessageEntity> ents) {
+        if (ents == null) return "";
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < ents.size(); i++) {
+            TLRPC.MessageEntity e = ents.get(i);
+            if (e instanceof TLRPC.TL_messageEntityCustomEmoji) {
+                sb.append(e.offset).append(',').append(e.length).append(',').append(((TLRPC.TL_messageEntityCustomEmoji) e).document_id).append(';');
+            }
+        }
+        return sb.toString();
+    }
+
+    public static boolean hasCustom(ArrayList<TLRPC.MessageEntity> ents) {
+        if (ents == null) return false;
+        for (int i = 0; i < ents.size(); i++) {
+            if (ents.get(i) instanceof TLRPC.TL_messageEntityCustomEmoji) return true;
+        }
+        return false;
+    }
+
+    private static void inject(ArrayList<TLRPC.MessageEntity> target, String data) {
+        for (String part : data.split(";")) {
+            if (part.isEmpty()) continue;
+            String[] p = part.split(",");
+            if (p.length != 3) continue;
+            try {
+                TLRPC.TL_messageEntityCustomEmoji e = new TLRPC.TL_messageEntityCustomEmoji();
+                e.offset = Integer.parseInt(p[0]);
+                e.length = Integer.parseInt(p[1]);
+                e.document_id = Long.parseLong(p[2]);
+                target.add(e);
+            } catch (Throwable ignore) {
+            }
+        }
+    }
+
+    /** Called when the server acknowledges a message we sent (before the server entities replace the local ones). */
+    public static void capture(long dialogId, int oldId, ArrayList<TLRPC.MessageEntity> localEntities) {
+        if (!hasCustom(localEntities)) return;
+        pending.put(dialogId + ":" + oldId, serialize(localEntities));
+    }
+
+    /** Re-attach the remembered emoji to the acknowledged message and persist them under the real id. */
+    public static void restore(int oldId, TLRPC.Message msg) {
+        if (msg == null) return;
+        String data = pending.remove(msg.dialog_id + ":" + oldId);
+        if (data == null) return;
+        if (msg.entities == null) msg.entities = new ArrayList<>();
+        if (!hasCustom(msg.entities)) {
+            inject(msg.entities, data);
+            if (!msg.entities.isEmpty()) msg.flags |= TLRPC.MESSAGE_FLAG_HAS_ENTITIES;
+        }
+        try {
+            prefs().edit().putString(msg.dialog_id + ":" + msg.id, data).apply();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    /** Called when a MessageObject is built, so reloads from the database still show our emoji. */
+    public static void apply(TLRPC.Message msg) {
+        if (msg == null || !msg.out || msg.id <= 0) return;
+        try {
+            if (msg.entities != null && hasCustom(msg.entities)) return;
+            String data = prefs().getString(MessageObject.getDialogId(msg) + ":" + msg.id, null);
+            if (data == null) return;
+            if (msg.entities == null) msg.entities = new ArrayList<>();
+            inject(msg.entities, data);
+            if (!msg.entities.isEmpty()) msg.flags |= TLRPC.MESSAGE_FLAG_HAS_ENTITIES;
+        } catch (Throwable ignore) {
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/Ni12VoiceEffect.java b/TMessagesProj/src/main/java/org/telegram/messenger/Ni12VoiceEffect.java
new file mode 100644
index 00000000..c38ed31e
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/Ni12VoiceEffect.java
@@ -0,0 +1,134 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/**
+ * ni12gram voice changer. Works on 16-bit mono PCM. Pure Java, no Android deps in the DSP part.
+ * Modes: 0 = off, 1 = robot (metallic), 2 = anonymous (deep, masked).
+ */
+public final class Ni12VoiceEffect {
+
+    public static final int OFF = 0, ROBOT = 1, ANONYMOUS = 2;
+    private static volatile int mode = -1;
+
+    // ---- settings ----
+    public static int getMode() {
+        if (mode < 0) {
+            try {
+                SharedPreferences p = ApplicationLoader.applicationContext.getSharedPreferences("ni12voice", Context.MODE_PRIVATE);
+                mode = p.getInt("mode", OFF);
+            } catch (Throwable t) {
+                mode = OFF;
+            }
+        }
+        return mode;
+    }
+
+    public static void setMode(int m) {
+        mode = m;
+        try {
+            ApplicationLoader.applicationContext.getSharedPreferences("ni12voice", Context.MODE_PRIVATE).edit().putInt("mode", m).apply();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    // ---- DSP state (one instance per audio path) ----
+    private final int rate;
+    private int curMode = OFF;
+    private double phase;
+    // robot comb
+    private final float[] comb;
+    private int combPos;
+    // anonymous pitch shifter (two crossfaded read taps over a delay line)
+    private final float[] dl;
+    private int dlW;
+    private double tapPos;
+    private float lp;
+
+    public Ni12VoiceEffect(int sampleRate) {
+        rate = sampleRate;
+        comb = new float[Math.max(2, sampleRate * 4 / 1000)];
+        dl = new float[Math.max(64, sampleRate * 60 / 1000)];
+    }
+
+    /** Process interleaved-less mono 16-bit little-endian samples in place. */
+    public void process(ByteBuffer buf, int bytes) {
+        int m = getMode();
+        if (m != curMode) {
+            curMode = m;
+            java.util.Arrays.fill(comb, 0);
+            java.util.Arrays.fill(dl, 0);
+            tapPos = 0;
+            lp = 0;
+        }
+        if (m == OFF) return;
+        ByteOrder old = buf.order();
+        buf.order(ByteOrder.LITTLE_ENDIAN);
+        int start = buf.position();
+        int n = bytes / 2;
+        for (int i = 0; i < n; i++) {
+            int idx = start + i * 2;
+            if (idx + 1 >= buf.limit()) break;
+            float x = buf.getShort(idx) / 32768f;
+            float y = m == ROBOT ? robot(x) : anonymous(x);
+            if (y > 1f) y = 1f; else if (y < -1f) y = -1f;
+            buf.putShort(idx, (short) (y * 32767f));
+        }
+        buf.order(old);
+    }
+
+    private float robot(float x) {
+        // ring modulation gives the "metal" tone
+        double w = 2 * Math.PI * 70.0 / rate;
+        phase += w;
+        if (phase > 2 * Math.PI) phase -= 2 * Math.PI;
+        float rm = (float) (x * Math.sin(phase));
+        // short comb filter adds the hollow resonance
+        float c = comb[combPos];
+        float y = 0.55f * x + 0.9f * rm + 0.45f * c;
+        comb[combPos] = clampf(y * 0.6f);
+        if (++combPos >= comb.length) combPos = 0;
+        return y * 0.85f;
+    }
+
+    private float anonymous(float x) {
+        // pitch down by ratio r (~ -6 semitones)
+        final float r = 0.707f;
+        final int len = dl.length;
+        final int win = len - 2;
+        dl[dlW] = x;
+        // tap delay sweeps 0..win; at ratio<1 delay grows by (1-r) per sample
+        tapPos += (1.0 - r);
+        if (tapPos >= win) tapPos -= win;
+        double d1 = tapPos;
+        double d2 = tapPos + win / 2.0;
+        if (d2 >= win) d2 -= win;
+        float s1 = read(d1), s2 = read(d2);
+        float g1 = (float) Math.sin(Math.PI * d1 / win);
+        float g2 = (float) Math.sin(Math.PI * d2 / win);
+        g1 *= g1; g2 *= g2; // equal-power-ish sum of squares of sin = 1
+        float y = s1 * g1 + s2 * g2;
+        if (++dlW >= len) dlW = 0;
+        // darken slightly + mild drive for a masked tone
+        lp += 0.35f * (y - lp);
+        float o = (float) Math.tanh(lp * 1.6f) * 0.9f;
+        return o;
+    }
+
+    private float read(double delay) {
+        double pos = dlW - delay;
+        while (pos < 0) pos += dl.length;
+        int i0 = (int) pos;
+        float f = (float) (pos - i0);
+        int i1 = i0 + 1 >= dl.length ? 0 : i0 + 1;
+        return dl[i0] * (1 - f) + dl[i1] * f;
+    }
+
+    private static float clampf(float v) {
+        return v > 1f ? 1f : (v < -1f ? -1f : v);
+    }
+}
