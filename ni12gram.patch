@@ -0,0 +1,41 @@
+package top.nkbe.niagram.helpers;
+
+/** Rough account / chat creation date estimated from the Telegram ID (interpolated; accuracy is months to about a year). */
+public final class Ni12IdDate {
+
+    private static final double[][] USERS = {
+            {1e6, 2013.7}, {1e7, 2013.95}, {1e8, 2014.75}, {2e8, 2015.45}, {3e8, 2015.95}, {4e8, 2016.35},
+            {5e8, 2016.75}, {6e8, 2017.1}, {7e8, 2017.45}, {8e8, 2017.8}, {1e9, 2018.35}, {1.5e9, 2019.3},
+            {2e9, 2020.0}, {3e9, 2020.9}, {4e9, 2021.4}, {5e9, 2021.9}, {5.5e9, 2022.4}, {6e9, 2022.9},
+            {6.5e9, 2023.4}, {7e9, 2023.9}, {7.5e9, 2024.5}, {8e9, 2025.0}, {8.5e9, 2025.6}, {9e9, 2026.2}
+    };
+    private static final double[][] CHATS = {
+            {1e6, 2014.0}, {1e8, 2016.0}, {5e8, 2017.8}, {1e9, 2018.9}, {1.2e9, 2019.5}, {1.5e9, 2020.2},
+            {1.8e9, 2021.4}, {2e9, 2022.0}, {2.2e9, 2023.0}, {2.5e9, 2024.0}, {2.8e9, 2025.0}, {3.1e9, 2026.0}
+    };
+
+    public static String estimate(long id, boolean chat) {
+        long v = Math.abs(id);
+        if (v >= 1000000000000L) v -= 1000000000000L; // -100xxxxxxxxxx channel form
+        if (v <= 0) return "";
+        double[][] t = chat ? CHATS : USERS;
+        double year;
+        if (v <= t[0][0]) {
+            year = t[0][1];
+        } else if (v >= t[t.length - 1][0]) {
+            year = t[t.length - 1][1];
+        } else {
+            year = t[0][1];
+            for (int i = 1; i < t.length; i++) {
+                if (v <= t[i][0]) {
+                    double f = (v - t[i - 1][0]) / (t[i][0] - t[i - 1][0]);
+                    year = t[i - 1][1] + f * (t[i][1] - t[i - 1][1]);
+                    break;
+                }
+            }
+        }
+        int y = (int) Math.floor(year);
+        int m = Math.min(12, (int) ((year - y) * 12) + 1);
+        return String.format(java.util.Locale.US, "≈ %d/%02d", y, m);
+    }
+}
